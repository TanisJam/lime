{
  "name": "@tanisjam/lime-styles",
  "version": "0.1.0",
  "description": "LIME built-in StylePacks — genre presets, tuning and General MIDI program tables for the LIME composer.",
  "type": "module",
  "license": "MIT",
  "author": "Mauricio Romero",
  "homepage": "https://github.com/TanisJam/lime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanisJam/lime.git",
    "directory": "packages/styles"
  },
  "bugs": {
    "url": "https://github.com/TanisJam/lime/issues"
  },
  "keywords": [
    "music",
    "generative",
    "adaptive",
    "stylepack",
    "genre",
    "composer"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@tanisjam/lime-core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
