{
  "name": "@tanisjam/lime-renderer-tone",
  "version": "0.1.0",
  "description": "LIME browser renderer using Tone.js. The only place Tone.js is allowed.",
  "type": "module",
  "license": "MIT",
  "author": "Mauricio Romero",
  "homepage": "https://github.com/TanisJam/lime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanisJam/lime.git",
    "directory": "packages/renderer-tone"
  },
  "bugs": {
    "url": "https://github.com/TanisJam/lime/issues"
  },
  "keywords": [
    "music",
    "tone.js",
    "web-audio",
    "renderer",
    "generative",
    "adaptive"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@tanisjam/lime-core": "workspace:^"
  },
  "peerDependencies": {
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "tone": "^15.0.4",
    "typescript": "^5.5.4"
  }
}
